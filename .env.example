# Instance configuration. Copy to .env and fill in; .env is gitignored.
# Generated from config/schema.mjs by `npm run config:example`. Do not edit by hand.
#
# var    -> plain Worker var (rendered into wrangler.jsonc)
# secret -> uploaded as a Worker secret by `npm run secrets:push`, never written to wrangler.jsonc
# deploy -> used by local scripts only

# --- Instance ---
# Public origin of the web app. Passkeys are bound to this host; do not change it after setup. (var, required)
APP_ORIGIN=https://mail.example.com
# The primary native mailbox. Its domain is the primary mail domain. (var, required)
PRIMARY_ADDRESS=hello@example.com
# Reserved administrator sign-in (password + passkey). Not a mailbox. (var, required)
ADMIN_ADDRESS=admin@example.com

# --- Branding ---
# App name shown in the UI, tab title and PWA. (var, optional)
BRAND_NAME=Example Mail
# Short PWA name (home screen label). (var, optional)
BRAND_SHORT_NAME=Mail
# Sender name used for the primary mailbox. (var, optional)
OWNER_DISPLAY_NAME=Alex
# Label for the primary mailbox in account lists. (var, optional)
PRIMARY_DISPLAY_NAME=Example Mail
# admin = branding editable in the admin panel; env = these values always win and the admin UI is read-only. (var, optional)
BRANDING_SOURCE=admin

# --- Mail ---
# Optional comma-separated extra mail domains, created as pending. Removing one here never disables it. (var, optional)
MAIL_DOMAINS=
# Optional address that receives a copy of primary-mailbox mail. (var, optional)
FORWARD_TO=
# Maximum native mailboxes across all domains. (var, optional)
MAX_MAILBOXES=100
# true lets non-primary mailboxes send through Cloudflare Email Sending. Only enable if Cloudflare's terms allow your use. (var, optional)
MULTI_SENDER_APPROVED=false
# true lets the daily cron permanently purge mailboxes past their 30-day grace period. (var, optional)
MAILBOX_PURGE_ENABLED=false

# --- Secrets ---
# One-time secret for registering the owner passkey. Remove after setup. (secret, optional)
AUTH_SETUP_TOKEN=
# Encrypts stored Gmail OAuth tokens. Required for Gmail. Changing it invalidates connected accounts. (secret, optional)
PROVIDER_CREDENTIAL_KEY=
# Google OAuth client for connected Gmail accounts. (secret, optional)
GOOGLE_CLIENT_ID=
# Google OAuth client secret. (secret, optional)
GOOGLE_CLIENT_SECRET=
# Web Push public key (base64url). (secret, optional)
VAPID_PUBLIC_KEY=
# Web Push private key (base64url). (secret, optional)
VAPID_PRIVATE_KEY=
# Optional Resend API key (sending access only). Enables the Resend transport for domains switched to it. (secret, optional)
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...). (secret, optional)
RESEND_WEBHOOK_SECRET=

# --- Cloudflare deployment ---
# Cloudflare account ID. Used by scripts only. (deploy, required)
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers Scripts edit, D1 edit, R2 edit and Account Settings read. Used by scripts only. (deploy, required)
CLOUDFLARE_API_TOKEN=
# (deploy, optional)
WORKER_NAME=ltm-email-service
# (deploy, optional)
D1_DATABASE_NAME=ltm-email-service
# Optional. Resolved by name through the Cloudflare API when empty; `npm run setup` fills it in. (deploy, optional)
D1_DATABASE_ID=
# (deploy, optional)
R2_BUCKET_NAME=ltm-email-service-mail
