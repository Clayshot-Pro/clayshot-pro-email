# For deploying from your computer only. Copy to .env and fill in; .env is gitignored. Never commit it.
# Automatic deploys from main (Cloudflare Workers Builds) need no .env: set CLOUDFLARE_ACCOUNT_ID and
# CLOUDFLARE_API_TOKEN as Workers Builds build variables, and the secrets below under the Worker's
# Settings -> Variables & Secrets (type Secret). See README step 2.
# Generated from config/schema.mjs by `npm run config:example`. Do not edit by hand.
#
# Instance settings (primary mailbox, domains, branding, forwarding, limits) are not
# configured here: choose them in first-run setup and the admin panel (stored in D1).
#
# secret -> uploaded as a Worker secret by `npm run secrets:push`
# deploy -> used by local scripts and the Workers Builds build only

# --- Sending (optional) ---
# Optional. Cloudflare sending works without it through the Worker's send binding. Set an Email Sending token only to use the REST API instead. (secret, optional)
CF_EMAIL_SENDING_TOKEN=

# --- First-run setup ---
# One-time secret for choosing the primary mailbox and registering the owner passkey. Remove after setup. (secret, optional)
AUTH_SETUP_TOKEN=

# --- Connected Gmail (optional) ---
# Encrypts stored Gmail OAuth tokens. Required for Gmail. Changing it invalidates connected accounts. (secret, optional)
PROVIDER_CREDENTIAL_KEY=
# Google OAuth client ID. (secret, optional)
GOOGLE_CLIENT_ID=
# Google OAuth client secret. (secret, optional)
GOOGLE_CLIENT_SECRET=

# --- Push notifications (optional) ---
# Web Push public key (base64url). (secret, optional)
VAPID_PUBLIC_KEY=
# Web Push private key (base64url). (secret, optional)
VAPID_PRIVATE_KEY=

# --- Resend (optional) ---
# Resend API key (sending access only). Enables Resend for domains the admin switches to it. (secret, optional)
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...). (secret, optional)
RESEND_WEBHOOK_SECRET=

# --- Cloudflare deployment ---
# Cloudflare account ID. Used by scripts and for the Email Sending API. (deploy, required)
CLOUDFLARE_ACCOUNT_ID=
# Deploy token with Workers Scripts edit, D1 edit, R2 edit and Account Settings read. Used by scripts only. (deploy, required)
CLOUDFLARE_API_TOKEN=
# (deploy, optional)
WORKER_NAME=ltm-email-service
# (deploy, optional)
D1_DATABASE_NAME=ltm-email-service
# Optional. Resolved by name through the Cloudflare API when empty; `npm run setup` fills it in. (deploy, optional)
D1_DATABASE_ID=
# (deploy, optional)
R2_BUCKET_NAME=ltm-email-service-mail
