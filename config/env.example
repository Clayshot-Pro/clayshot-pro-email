# For deploying from your computer only: cp config/env.example .env, then fill it in. .env is gitignored.
# The Deploy to Cloudflare button and GitHub Actions need no .env (see README). Most installs need nothing
# here but the two deploy keys: the deploy or npm run setup creates PROVIDER_CREDENTIAL_KEY, and other keys go in
# Admin -> Keys in the app.
# Generated from config/schema.mjs by `npm run config:example`. Do not edit by hand.
#
# Instance settings (mail domain, mailboxes, branding, forwarding, limits) are not
# configured here: choose them in first-run setup and the admin panel (stored in D1).
#
# secret -> uploaded as a Worker secret by `npm run secrets:push`
# deploy -> used by deploy scripts; never uploaded from .env as Worker secrets

# --- Encryption ---
# Encrypts the keys and Gmail tokens stored in the database. The GitHub Actions deploy creates it when missing; first-run setup with a Cloudflare token and npm run setup do too. Back it up (Admin -> Keys -> Back up encryption key): changing it makes stored keys and connected Gmail accounts unreadable. (secret, optional)
PROVIDER_CREDENTIAL_KEY=

# --- First-run setup ---
# Optional. A one-time setup secret for installs that do not connect a Cloudflare token at setup. Setup stops accepting it once an administrator passkey exists. (secret, optional)
AUTH_SETUP_TOKEN=

# --- Sending (optional; or set in Admin -> Keys) ---
# Optional. Cloudflare sending works without it through the Worker's send binding. Set an Email Sending token only to use the REST API instead. (secret, optional)
CF_EMAIL_SENDING_TOKEN=

# --- Connected Gmail (optional; or set in Admin -> Keys) ---
# Google OAuth client ID. (secret, optional)
GOOGLE_CLIENT_ID=
# Google OAuth client secret. (secret, optional)
GOOGLE_CLIENT_SECRET=

# --- Push notifications (optional; generated automatically when unset) ---
# Web Push public key (base64url). (secret, optional)
VAPID_PUBLIC_KEY=
# Web Push private key (base64url). (secret, optional)
VAPID_PRIVATE_KEY=

# --- Resend (optional; or set in Admin -> Keys) ---
# Resend API key (sending access only). Enables Resend for domains the admin switches to it. (secret, optional)
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...). (secret, optional)
RESEND_WEBHOOK_SECRET=

# --- Cloudflare deployment ---
# Cloudflare account ID. Used by scripts and for the Email Sending API. (deploy, required)
CLOUDFLARE_ACCOUNT_ID=
# The one Cloudflare API token (README, step 1.2): Workers Scripts, D1 and R2 edit and Account Settings read for deploys, plus Email Sending, Zone, Zone Settings, DNS and Email Routing Rules for domain setup. Used by deploy scripts; the GitHub Actions deploy also gives it to the app (CLOUDFLARE_DEPLOY_CONNECTION). (deploy, required)
CLOUDFLARE_API_TOKEN=
# Optional. Defaults to "name" in wrangler.jsonc. (deploy, optional)
WORKER_NAME=
# Optional. Defaults to the DB binding's database_name in wrangler.jsonc. (deploy, optional)
D1_DATABASE_NAME=
# Optional. Taken from wrangler.jsonc, or resolved by name through the Cloudflare API; `npm run setup` fills it in. (deploy, optional)
D1_DATABASE_ID=
# Optional. Defaults to the MAIL binding's bucket_name in wrangler.jsonc. (deploy, optional)
R2_BUCKET_NAME=
