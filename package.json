{
  "name": "ltm-email-service",
  "private": true,
  "version": "3.23.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/config-render.mjs && vite dev",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/config-render.mjs && npm run typecheck && vite build",
    "build:cloudflare": "npm run build",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/assert-cloudflare-production.mjs && node scripts/verify-production-d1.mjs && node scripts/migrate-remote.mjs && node scripts/wrangler-deploy.mjs && node scripts/ensure-worker-secrets.mjs",
    "deploy:self": "node scripts/deploy-self.mjs",
    "setup": "node scripts/setup.mjs",
    "config:render": "node scripts/config-render.mjs",
    "config:example": "node scripts/config-example.mjs",
    "secrets:push": "node scripts/secrets-push.mjs",
    "test": "node scripts/run-tests.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:e2e": "node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^13.2.2",
    "postal-mime": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.130.0"
  }
}
