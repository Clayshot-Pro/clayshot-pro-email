{
  // Template for the gitignored wrangler.jsonc. Rendered by `npm run config:render`
  // (see config/schema.mjs). The Worker has no instance vars: settings live in D1,
  // credentials are Worker secrets. Sending uses the Email Sending API, not bindings.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/index.html", "/manifest.webmanifest"]
  },
  "vars": "__VARS__",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__D1_DATABASE_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL",
      "bucket_name": "__R2_BUCKET_NAME__"
    }
  ],
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": {
    "enabled": true
  }
}
